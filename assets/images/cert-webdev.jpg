  </defs>
  <rect width="800" height="500" fill="url(#c-bg)" rx="12"/>
  <rect x="20" y="20" width="760" height="460" fill="none" stroke="#a855f7" stroke-width="2" stroke-dasharray="8,6" rx="8"/>
  
