<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="ev-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#140f28"/>
      <stop offset="50%" stop-color="#241445"/>
      <stop offset="100%" stop-color="#0e0a1f"/>
    </linearGradient>
    <linearGradient id="ev-purple" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a855f7"/>
      <stop offset="100%" stop-color="#ec4899"/>
    </linearGradient>
    <radialGradient id="ev-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#a855f7" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="800" height="500" fill="url(#ev-bg)"/>
  <circle cx="400" cy="240" r="230" fill="url(#ev-glow)"/>

  <!-- Code / Grid geometry -->
  <g opacity="0.15" stroke="#a855f7" stroke-width="1">
    <circle cx="400" cy="220" r="160" fill="none" stroke-dasharray="4,8"/>
    <circle cx="400" cy="220" r="120" fill="none"/>
    <circle cx="400" cy="220" r="80" fill="none"/>
  </g>

  <!-- Central Cloud & Book Icon -->
  <g transform="translate(400, 200)">
    <rect x="-65" y="-50" width="130" height="90" rx="16" fill="#301b5c" stroke="#a855f7" stroke-width="3"/>
    <!-- Graduation Cap / Book -->
    <path d="M -35 -10 L 0 -28 L 35 -10 L 0 8 Z" fill="#ec4899" opacity="0.9"/>
    <path d="M -25 0 L -25 20 C -25 28 25 28 25 20 L 25 0" fill="none" stroke="#ffffff" stroke-width="2.5"/>
    <line x1="30" y1="-8" x2="30" y2="18" stroke="#ec4899" stroke-width="2"/>
    <circle cx="30" cy="22" r="3" fill="#ec4899"/>
  </g>

  <!-- Title & Subtitle -->
  <text x="400" y="375" font-family="'Space Grotesk', system-ui, sans-serif" font-size="28" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">
    EDUVAULT
  </text>
  <text x="400" y="410" font-family="'IBM Plex Mono', monospace" font-size="14" fill="#d8b4fe" text-anchor="middle" letter-spacing="1">
    SPRING BOOT &amp; NEXT.JS CLOUD PLATFORM
  </text>

  <!-- Status badges -->
  <g transform="translate(40, 40)">
    <rect width="125" height="28" rx="14" fill="#a855f7" fill-opacity="0.2" stroke="#a855f7" stroke-width="1"/>
    <circle cx="18" cy="14" r="4" fill="#a855f7"/>
    <text x="32" y="19" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#e9d5ff" font-weight="600">AWS DEPLOYED</text>
  </g>
</svg>
