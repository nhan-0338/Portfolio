<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sraa-c-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a2006"/>
      <stop offset="100%" stop-color="#4a360a"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#sraa-c-bg)" rx="12"/>
  <rect x="20" y="20" width="760" height="460" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="8,6" rx="8"/>
  
  <g transform="translate(400, 100)">
    <circle cx="0" cy="0" r="40" fill="#b45309" fill-opacity="0.3" stroke="#f59e0b" stroke-width="2"/>
    <text x="0" y="10" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="bold" fill="#fbbf24" text-anchor="middle">1st</text>
  </g>

  <text x="400" y="190" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="600" fill="#fbbf24" text-anchor="middle" letter-spacing="3">SCIENTIFIC RESEARCH AWARD</text>
  <text x="400" y="250" font-family="'Space Grotesk', sans-serif" font-size="26" font-weight="700" fill="#ffffff" text-anchor="middle">First Prize (A Award) - 7th SRAA 2025</text>
  <text x="400" y="310" font-family="'IBM Plex Mono', monospace" font-size="16" fill="#94a3b8" text-anchor="middle">Awarded to Ho Duc Nhan • Accounting &amp; Auditing Research</text>
  <text x="400" y="370" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#fbbf24" text-anchor="middle">[ UEH SCIENTIFIC EXCELLENCE ]</text>
</svg>
