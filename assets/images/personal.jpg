<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 700" width="100%" height="100%">
  <defs>
    <linearGradient id="nhan-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a192f"/>
      <stop offset="50%" stop-color="#112240"/>
      <stop offset="100%" stop-color="#020c1b"/>
    </linearGradient>
    <linearGradient id="nhan-gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f2fe"/>
      <stop offset="100%" stop-color="#4facfe"/>
    </linearGradient>
    <radialGradient id="nhan-ambient" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#00f2fe" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="600" height="700" fill="url(#nhan-bg)"/>
  <circle cx="300" cy="280" r="230" fill="url(#nhan-ambient)"/>

  <!-- Geometric rings -->
  <circle cx="300" cy="280" r="180" fill="none" stroke="#233554" stroke-width="2"/>
  <circle cx="300" cy="280" r="170" fill="none" stroke="#00f2fe" stroke-width="1.5" stroke-dasharray="6,6" opacity="0.6"/>

  <!-- Professional Finance & Analyst Silhouette -->
  <g transform="translate(300, 290)">
    <!-- Suit / Blazer -->
    <path d="M -130 190 C -130 95, -70 65, 0 65 C 70 65, 130 95, 130 190 Z" fill="#1e293b" stroke="#334155" stroke-width="2"/>
    <!-- Tie & Collar -->
    <polygon points="-30,65 0,110 30,65" fill="#f8fafc"/>
    <polygon points="-12,75 12,75 8,160 0,180 -8,160" fill="#0284c7"/>
    <!-- Head -->
    <ellipse cx="0" cy="-20" rx="65" ry="78" fill="#cbd5e1"/>
    <!-- Hair -->
    <path d="M -65 -30 C -65 -90, -25 -115, 0 -115 C 35 -115, 65 -90, 65 -30 C 50 -80, -20 -95, -65 -30 Z" fill="#0f172a"/>
  </g>

  <!-- Name & Qualification Tag -->
  <g transform="translate(300, 540)">
    <rect x="-160" y="-22" width="320" height="44" rx="22" fill="#030712" fill-opacity="0.9" stroke="#00f2fe" stroke-width="1.5"/>
    <text x="0" y="6" font-family="'Space Grotesk', system-ui, sans-serif" font-size="15" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">
      HO DUC NHAN <tspan fill="#00f2fe">· UEH</tspan>
    </text>
  </g>

  <g transform="translate(300, 605)">
    <rect x="-130" y="-16" width="260" height="32" rx="16" fill="#0b1329" stroke="#38bdf8" stroke-width="1"/>
    <text x="0" y="5" font-family="'IBM Plex Mono', monospace" font-size="12" font-weight="600" fill="#38bdf8" text-anchor="middle">
      INTERNATIONAL FINANCE · GPA 3.8
    </text>
  </g>
</svg>
