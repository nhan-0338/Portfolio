<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sraa-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0c192c"/>
      <stop offset="50%" stop-color="#162e52"/>
      <stop offset="100%" stop-color="#091322"/>
    </linearGradient>
    <linearGradient id="gold-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>

  <rect width="800" height="500" fill="url(#sraa-bg)"/>
  
  <!-- Subtle analytical charts in background -->
  <g opacity="0.15" stroke="#38bdf8" stroke-width="1.5">
    <polyline points="100,400 220,330 340,360 460,240 580,270 700,160" fill="none"/>
    <polyline points="100,420 220,380 340,320 460,340 580,210 700,120" fill="none" stroke="#fbbf24"/>
  </g>

  <!-- Central Trophy & Research Emblem -->
  <g transform="translate(400, 190)">
    <circle cx="0" cy="0" r="70" fill="#1e3a8a" fill-opacity="0.4" stroke="#38bdf8" stroke-width="2"/>
    <!-- Trophy Icon -->
    <path d="M -25 -25 L -35 -25 C -45 -25 -45 5 -30 10 L -20 12 M 25 -25 L 35 -25 C 45 -25 45 5 30 10 L 20 12" fill="none" stroke="#fbbf24" stroke-width="3"/>
    <path d="M -25 -30 L 25 -30 L 20 15 C 20 30 0 35 0 35 C 0 35 -20 30 -20 15 Z" fill="#b45309" stroke="#fbbf24" stroke-width="3"/>
    <rect x="-8" y="35" width="16" height="20" fill="#fbbf24"/>
    <rect x="-24" y="55" width="48" height="12" rx="3" fill="#fbbf24"/>
  </g>

  <!-- Title & Research Details -->
  <text x="400" y="350" font-family="'Space Grotesk', sans-serif" font-size="24" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="1">
    SRAA 2025 FIRST PRIZE (A AWARD)
  </text>
  <text x="400" y="385" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="500" fill="#38bdf8" text-anchor="middle">
    Unmasking Earnings Management in the Digital Era
  </text>
  <text x="400" y="420" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#94a3b8" text-anchor="middle">
    Accounting Conservatism &amp; Econometric Analysis in Ho Chi Minh City
  </text>

  <!-- Badge -->
  <g transform="translate(40, 40)">
    <rect width="170" height="30" rx="15" fill="#f59e0b" fill-opacity="0.2" stroke="#f59e0b" stroke-width="1.5"/>
    <circle cx="18" cy="15" r="5" fill="#fbbf24"/>
    <text x="32" y="20" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#fef3c7" font-weight="700">SCIENTIFIC RESEARCH</text>
  </g>
</svg>
