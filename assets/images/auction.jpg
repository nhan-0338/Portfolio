<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="auc-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f2b23"/>
      <stop offset="50%" stop-color="#134135"/>
      <stop offset="100%" stop-color="#071813"/>
    </linearGradient>
    <linearGradient id="auc-emerald" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#34d399"/>
    </linearGradient>
    <radialGradient id="auc-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <rect width="800" height="500" fill="url(#auc-bg)"/>
  <circle cx="400" cy="230" r="220" fill="url(#auc-glow)"/>

  <!-- Pulse Circles -->
  <g opacity="0.2" stroke="#34d399" stroke-width="1.5">
    <circle cx="400" cy="210" r="140" fill="none" stroke-dasharray="5,5"/>
    <circle cx="400" cy="210" r="100" fill="none"/>
    <circle cx="400" cy="210" r="60" fill="none"/>
  </g>

  <!-- Auction Gavel / Real-time Bidding Icon -->
  <g transform="translate(400, 200)">
    <!-- Stand -->
    <rect x="-45" y="30" width="90" height="12" rx="4" fill="#047857"/>
    <!-- Hammer -->
    <g transform="rotate(-30)">
      <rect x="-10" y="-35" width="20" height="40" rx="4" fill="#34d399"/>
      <rect x="-4" y="5" width="8" height="50" rx="3" fill="#ffffff"/>
    </g>
    <!-- Lightning pulse -->
    <path d="M 25 -30 L 40 -15 L 32 -12 L 48 5" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Title & Subtitle -->
  <text x="400" y="375" font-family="'Space Grotesk', system-ui, sans-serif" font-size="28" font-weight="700" fill="#ffffff" text-anchor="middle" letter-spacing="2">
    ONLINE AUCTION SYSTEM
  </text>
  <text x="400" y="410" font-family="'IBM Plex Mono', monospace" font-size="14" fill="#6ee7b7" text-anchor="middle" letter-spacing="1">
    REAL-TIME BIDDING &amp; COMMERCE PLATFORM
  </text>

  <!-- Status badges -->
  <g transform="translate(40, 40)">
    <rect width="130" height="28" rx="14" fill="#10b981" fill-opacity="0.2" stroke="#10b981" stroke-width="1"/>
    <circle cx="18" cy="14" r="4" fill="#34d399"/>
    <text x="32" y="19" font-family="'IBM Plex Mono', monospace" font-size="11" fill="#a7f3d0" font-weight="600">WEBSOCKET LIVE</text>
  </g>
</svg>
