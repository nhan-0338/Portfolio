<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="acca-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e102d"/>
      <stop offset="100%" stop-color="#2d1345"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#acca-bg)" rx="12"/>
  <rect x="20" y="20" width="760" height="460" fill="none" stroke="#d946ef" stroke-width="2" stroke-dasharray="8,6" rx="8"/>
  
  <g transform="translate(400, 100)">
    <circle cx="0" cy="0" r="40" fill="#a21caf" fill-opacity="0.3" stroke="#d946ef" stroke-width="2"/>
    <text x="0" y="10" font-family="'Space Grotesk', sans-serif" font-size="22" font-weight="bold" fill="#d946ef" text-anchor="middle">ACCA</text>
  </g>

  <text x="400" y="190" font-family="'Space Grotesk', sans-serif" font-size="20" font-weight="600" fill="#d946ef" text-anchor="middle" letter-spacing="3">ACCA CERTIFICATE &amp; QUALIFICATION</text>
  <text x="400" y="250" font-family="'Space Grotesk', sans-serif" font-size="28" font-weight="700" fill="#ffffff" text-anchor="middle">ACCA: F1, F2, F3 Exemptions &amp; F7 Preparation</text>
  <text x="400" y="310" font-family="'IBM Plex Mono', monospace" font-size="16" fill="#94a3b8" text-anchor="middle">Awarded to Ho Duc Nhan • UEH International Finance</text>
  <text x="400" y="370" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#d946ef" text-anchor="middle">[ FINANCIAL REPORTING &amp; ACCOUNTING ]</text>
</svg>
