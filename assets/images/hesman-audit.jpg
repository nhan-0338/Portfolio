<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="hes-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#09182a"/>
      <stop offset="50%" stop-color="#0f2b48"/>
      <stop offset="100%" stop-color="#061220"/>
    </linearGradient>
  </defs>

  <rect width="800" height="500" fill="url(#hes-bg)"/>

  <!-- Audit Checklist UI -->
  <g transform="translate(400, 190)">
    <circle cx="0" cy="0" r="75" fill="#0369a1" fill-opacity="0.2" stroke="#00e5ff" stroke-width="2"/>
    <rect x="-40" y="-45" width="80" height="90" rx="10" fill="#0f172a" stroke="#00e5ff" stroke-width="2.5"/>
    <line x1="-20" y1="-25" x2="20" y2="-25" stroke="#38bdf8" stroke-width="3" stroke-linecap="round"/>
    <line x1="-20" y1="-10" x2="15" y2="-10" stroke="#38bdf8" stroke-width="3" stroke-linecap="round"/>
    <line x1="-20" y1="5" x2="20" y2="5" stroke="#38bdf8" stroke-width="3" stroke-linecap="round"/>
    <circle cx="-25" cy="25" r="4" fill="#22c55e"/>
    <line x1="-15" y1="25" x2="20" y2="25" stroke="#22c55e" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- Title & Subtitle -->
  <text x="400" y="350" font-family="'Space Grotesk', sans-serif" font-size="24" font-weight="700" fill="#ffffff" text-anchor="middle">
    INTERNAL CONTROL &amp; RECONCILIATION
  </text>
  <text x="400" y="385" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="500" fill="#00e5ff" text-anchor="middle">
    ShopDunk · Samcenter · Xiaomi (25 Southern Retail Stores)
  </text>
  <text x="400" y="420" font-family="'IBM Plex Mono', monospace" font-size="13" fill="#94a3b8" text-anchor="middle">
    500+ Daily Transactions Cross-Checked · Inventory Control &amp; Root-Cause Audit
  </text>

  <!-- Badge -->
  <g transform="translate(40, 40)">
    <rect width="180" height="30" rx="15" fill="#00e5ff" fill-opacity="0.2" stroke="#00e5ff" stroke-width="1.5"/>
    <circle cx="18" cy="15" r="5" fill="#00e5ff"/>
    <text x="32" y="20" font-family="'IBM Plex Mono', monospace" font-size="12" fill="#cffafe" font-weight="700">HESMAN GROUP AUDIT</text>
  </g>
</svg>
